[Unit]
Description=Mint the mapleset-forge GitHub App's installation tokens
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=forge-app
Group=forge-app
EnvironmentFile=/etc/forge-app.env
ExecStart=/usr/bin/python3 -I /usr/local/lib/forge-app/forge_mint.py
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/spool/forge-app
PrivateTmp=yes
