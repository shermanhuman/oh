#!/usr/bin/env python3
"""git credential helper: the factory App's token for github.com, by the URL's owner.

Needs `credential.https://github.com.useHttpPath true` so git sends the path.
A request without a path (mise installing a private github: tool) gets the
default account's token (plan row 13). Only `get` answers; store and erase
are no-ops, so git never writes the token anywhere.
"""
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.dirname(HERE))
import forge_client  # noqa: E402


def main():
    if len(sys.argv) < 2 or sys.argv[1] != "get":
        return 0
    fields = {}
    for line in sys.stdin:
        line = line.rstrip("\n")
        if not line:
            break
        key, _, value = line.partition("=")
        fields[key] = value
    if fields.get("host") != "github.com" or fields.get("protocol") not in ("https", None):
        return 0
    path = fields.get("path", "")
    owner = path.split("/", 1)[0] if path else None
    try:
        tok = forge_client.token(owner)
    except forge_client.ForgeError as e:
        print(e, file=sys.stderr)
        return 1
    sys.stdout.write(f"username=x-access-token\npassword={tok}\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
